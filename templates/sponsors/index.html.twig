{% extends 'base.html.twig' %}

{% block title %}Sponsors - EcoSpot{% endblock %}
{% block description %}Our partners in environmental conservation and sustainability{% endblock %}

{% block stylesheets %}
<style>
    .sponsors-header {
        background: linear-gradient(135deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=1200&fit=crop');
        background-size: cover;
        background-position: center;
        padding: 100px 0;
        color: white;
        text-align: center;
    }

    .sponsors-header h1 {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .breadcrumb {
        font-size: 1.1rem;
    }

    .breadcrumb a {
        color: #4CAF50;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .sponsors-section {
        padding: 80px 0;
        background: #f8f8f8;
    }

    .section-title {
        text-align: center;
        margin-bottom: 60px;
    }

    .section-title h2 {
        font-size: 2.5rem;
        color: #0d3b2f;
        margin-bottom: 15px;
    }

    .sponsors-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 30px;
    }

    .sponsor-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

    .sponsor-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .sponsor-image {
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }

    .sponsor-image img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .sponsor-card:hover .sponsor-image img {
        transform: scale(1.05);
    }

    .sponsor-content {
        padding: 30px;
        flex-grow: 1;
    }

    .sponsor-title {
        font-size: 1.4rem;
        color: #0d3b2f;
        margin-bottom: 15px;
        font-weight: 700;
        text-align: center;
    }

    .sponsor-description {
        color: #666;
        font-size: 0.95rem;
        margin-bottom: 20px;
        line-height: 1.6;
        text-align: center;
    }

    .sponsor-meta {
        display: flex;
        justify-content: space-around;
        align-items: center;
        padding: 15px 0;
        border-top: 1px solid #eee;
        font-size: 0.85rem;
        color: #666;
    }

    .sponsor-location,
    .sponsor-sector {
        display: flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
    }

    .sponsor-footer {
        padding: 15px;
        background: #fafafa;
        border-top: 1px solid #eee;
        text-align: center;
        color: #4CAF50;
        font-weight: 700;
        font-size: 0.9rem;
    }

    @media (max-width: 768px) {
        .sponsors-header h1 {
            font-size: 2rem;
        }

        .sponsors-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block content %}
<!-- Sponsors Header -->
<section class="sponsors-header">
    <div class="container">
        <h1>Our Partners & Sponsors</h1>
        <div class="breadcrumb">
            <a href="{{ path('app_index') }}">Home</a> // Sponsors
        </div>
    </div>
</section>

<!-- Sponsors Section -->
<section class="sponsors-section">
    <div class="container">
        <div class="section-title">
            <h2>Driving Environmental Change Together</h2>
            <p style="color: #666; max-width: 700px; margin: 0 auto;">We collaborate with organizations that share our
                vision for a greener, more sustainable planet.</p>
        </div>

        <div class="sponsors-grid">
            {% for sponsor in sponsors %}
            <a href="{{ path('app_sponsors_show', {'id': sponsor.id}) }}" class="sponsor-card-link"
                style="text-decoration: none; color: inherit;">
                <div class="sponsor-card">
                    <div class="sponsor-image">
                        {% if sponsor.image %}
                        <img src="{{ sponsor.image }}" alt="{{ sponsor.nom }}">
                        {% else %}
                        <div style="font-size: 4rem; color: #4CAF50;">🏢</div>
                        {% endif %}
                    </div>

                    <div class="sponsor-content">
                        <h3 class="sponsor-title">{{ sponsor.nom }}</h3>
                        <p class="sponsor-description">{{ sponsor.description|slice(0, 120) }}...</p>

                        <div class="sponsor-meta">
                            <div class="sponsor-sector">
                                <span>🏢</span>
                                <span>{{ sponsor.secteur }}</span>
                            </div>
                            <div class="sponsor-location">
                                <span>📍</span>
                                <span>{{ sponsor.localisation }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="sponsor-footer">
                        View Company Profile →
                    </div>
                </div>
            </a>
            {% else %}
            <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px;">
                <p style="font-size: 1.1rem; color: #999;">No sponsors available at this time.</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}