{% extends 'admin/layout.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .form-control.is-invalid {
        border-color: #c00;
        background-color: #fff8f8;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #0d3b2f;
    }

    .form-label.text-danger {
        color: #c00 !important;
    }

    .error-message {
        color: #c00;
        font-size: 0.9em;
        display: block;
        margin-top: 5px;
    }

    #map {
        height: 400px;
        width: 100%;
        border-radius: 8px;
        margin-top: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        z-index: 1;
    }
</style>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
{% endblock %}

{% block admin_content %}
<div class="admin-header">
    <h1>{% if isEdit %}Edit{% else %}Create{% endif %} Event</h1>
</div>

<div style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    {% if errors is not empty %}
    <div
        style="background: #fee; border: 1px solid #fcc; color: #c00; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
        <strong>Please fix the following errors:</strong>
        <ul style="margin: 10px 0 0 0; padding-left: 20px;">
            {% for message in errors %}
            <li>{{ message }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <form method="POST" enctype="multipart/form-data" novalidate style="display: grid; gap: 20px;">
        <div>
            <label class="form-label {% if errors.nom|default(false) %}text-danger{% endif %}">Event Name</label>
            <input type="text" name="nom" value="{{ event.nom|default('') }}"
                class="form-control {% if errors.nom|default(false) %}is-invalid{% endif %}">
            {% if errors.nom|default(false) %}<span class="error-message">{{ errors.nom }}</span>{% endif %}
        </div>

        <div>
            <label
                class="form-label {% if errors.description|default(false) %}text-danger{% endif %}">Description</label>
            <textarea name="description" rows="5"
                class="form-control {% if errors.description|default(false) %}is-invalid{% endif %}">{{ event.description|default('') }}</textarea>
            {% if errors.description|default(false) %}<span class="error-message">{{ errors.description }}</span>{%
            endif %}
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div>
                <label class="form-label {% if errors.dateDebut|default(false) %}text-danger{% endif %}">Start
                    Date</label>
                <input type="datetime-local" name="dateDebut"
                    value="{% if event.dateDebut %}{{ event.dateDebut|date('Y-m-d\\TH:i') }}{% endif %}"
                    class="form-control {% if errors.dateDebut|default(false) %}is-invalid{% endif %}">
                {% if errors.dateDebut|default(false) %}<span class="error-message">{{ errors.dateDebut }}</span>{%
                endif %}
            </div>

            <div>
                <label class="form-label {% if errors.dateFin|default(false) %}text-danger{% endif %}">End Date</label>
                <input type="datetime-local" name="dateFin"
                    value="{% if event.dateFin %}{{ event.dateFin|date('Y-m-d\\TH:i') }}{% endif %}"
                    class="form-control {% if errors.dateFin|default(false) %}is-invalid{% endif %}">
                {% if errors.dateFin|default(false) %}<span class="error-message">{{ errors.dateFin }}</span>{% endif %}
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div>
                <label class="form-label {% if errors.lieu|default(false) %}text-danger{% endif %}">Location
                    Name</label>
                <input type="text" name="lieu" value="{{ event.lieu|default('') }}"
                    class="form-control {% if errors.lieu|default(false) %}is-invalid{% endif %}" id="location-input">
                {% if errors.lieu|default(false) %}<span class="error-message">{{ errors.lieu }}</span>{% endif %}
            </div>

            <div>
                <label class="form-label">Capacity</label>
                <input type="number" name="capacite" value="{{ event.capacite|default('0') }}"
                    class="form-control {% if errors.capacite|default(false) %}is-invalid{% endif %}">
                {% if errors.capacite|default(false) %}<span class="error-message">{{ errors.capacite }}</span>{% endif
                %}
            </div>
        </div>

        <div>
            <label class="form-label">Precise Location (Click on the map)</label>
            <div id="map"></div>
            <input type="hidden" name="latitude" id="lat-input" value="{{ event.latitude|default('') }}">
            <input type="hidden" name="longitude" id="lng-input" value="{{ event.longitude|default('') }}">
            <p style="font-size: 0.8rem; color: #666; margin-top: 5px;">Drag the marker or click anywhere on the map to
                set the exact coordinates.</p>
        </div>

        <div>
            <label class="form-label">Event Image</label>
            <input type="file" name="image" accept="image/*" class="form-control">
            {% if event.image %}<p style="margin: 8px 0; font-size: 0.85rem; color: #666;">Current: {{ event.image }}
            </p>{% endif %}
        </div>

        <div>
            <label class="form-label">Sponsors</label>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; max-height: 200px; overflow-y: auto; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
                {% for sponsor in sponsors %}
                <label style="display: flex; align-items: center; gap: 8px; padding: 5px; cursor: pointer;">
                    <input type="checkbox" name="sponsors[]" value="{{ sponsor.id }}" {% if
                        event.sponsors.contains(sponsor) %}checked{% endif %}>
                    <span>{{ sponsor.nom }}</span>
                </label>
                {% else %}
                <p style="color: #666; grid-column: 1 / -1;">No sponsors available. <a
                        href="{{ path('admin_sponsors_new') }}">Create one</a></p>
                {% endfor %}
            </div>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 20px;">
            <button type="submit" class="admin-btn">{% if isEdit %}Update{% else %}Create{% endif %} Event</button>
            <a href="{{ path('admin_events_index') }}" class="admin-btn admin-btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Default coordinates (Paris or last saved location)
        var defaultLat = {{ event.latitude|default (48.8566)
    }};
    var defaultLng = {{ event.longitude|default (2.3522) }};
    var zoomLevel = {{ event.latitude ?15: 6 }};

    var map = L.map('map').setView([defaultLat, defaultLng], zoomLevel);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    var marker;

    // If we already have coordinates, place the marker
    {% if event.latitude and event.longitude %}
    marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);
    {% endif %}

    function updateInputs(lat, lng) {
        document.getElementById('lat-input').value = lat.toFixed(6);
        document.getElementById('lng-input').value = lng.toFixed(6);
    }

    map.on('click', function (e) {
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        if (marker) {
            marker.setLatLng(e.latlng);
        } else {
            marker = L.marker(e.latlng, { draggable: true }).addTo(map);
            marker.on('dragend', function (event) {
                var position = marker.getLatLng();
                updateInputs(position.lat, position.lng);
            });
        }
        updateInputs(lat, lng);
    });

    if (marker) {
        marker.on('dragend', function (event) {
            var position = marker.getLatLng();
            updateInputs(position.lat, position.lng);
        });
    }
    });
</script>
{% endblock %}