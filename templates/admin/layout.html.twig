{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - EcoSpot{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
{% endblock %}

{% block content %}
<div class="admin-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <h2>🍃 Admin Panel</h2>
        </div>
        <nav>
            <ul class="admin-menu">
                <li>
                    <a href="{{ path('admin_dashboard') }}"
                        class="{% if 'admin_dashboard' in app.request.attributes.get('_route') %}active{% endif %}">
                        📊 Dashboard
                    </a>
                </li>
                <li>
                    <a href="{{ path('admin_events_index') }}"
                        class="{% if 'admin_events' in app.request.attributes.get('_route') %}active{% endif %}">
                        🎯 Events
                    </a>
                </li>
                <li>
                    <a href="{{ path('admin_sponsors_index') }}"
                        class="{% if 'admin_sponsors' in app.request.attributes.get('_route') %}active{% endif %}">
                        🤝 Sponsors
                    </a>
                </li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <a href="{{ path('app_index') }}">
                ← Back to Site
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-content">
        {# Flash Messages #}
        <style>
            .flash-message {
                padding: 15px;
                margin-bottom: 20px;
                border-radius: 5px;
            }

            .flash-success {
                background: #e6fffa;
                border: 1px solid #b2f5ea;
                color: #2c7a7b;
            }

            .flash-error {
                background: #fff5f5;
                border: 1px solid #feb2b2;
                color: #c53030;
            }

            .flash-info {
                background: #ebf8ff;
                border: 1px solid #bee3f8;
                color: #2b6cb0;
            }
        </style>

        {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="flash-message flash-{{ label == 'success' ? 'success' : (label == 'error' ? 'error' : 'info') }}">
            {{ message }}
        </div>
        {% endfor %}
        {% endfor %}

        {% block admin_content %}{% endblock %}
    </main>
</div>
{% endblock %}