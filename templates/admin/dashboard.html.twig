{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
<div class="admin-header">
    <h1>Dashboard Overview</h1>
</div>

<div class="dashboard-grid">
    <div class="stat-card">
        <div class="stat-card-icon">🎯</div>
        <h3>Events Management</h3>
        <p>Create and manage your environmental events.</p>
        <a href="{{ path('admin_events_index') }}" class="admin-btn w-full">Manage Events</a>
    </div>

    <div class="stat-card">
        <div class="stat-card-icon">🤝</div>
        <h3>Sponsors & Partners</h3>
        <p>Manage your organization's sponsors.</p>
        <a href="{{ path('admin_sponsors_index') }}" class="admin-btn w-full">Manage Sponsors</a>
    </div>
</div>

<!-- Recent Events Section -->
<div class="section-header">
    <h2 class="section-title">Recent Events</h2>
    <a href="{{ path('admin_events_new') }}" class="admin-btn">+ Create Event</a>
</div>

{% if events|length > 0 %}
<div class="events-grid">
    {% for event in events %}
    <div class="event-card">
        {% if event.image %}
        <img src="{{ event.image }}" alt="{{ event.nom }}" class="event-image">
        {% else %}
        <div class="event-placeholder">📅</div>
        {% endif %}

        <div class="event-content">
            <h3 class="event-title">{{ event.nom }}</h3>
            <p class="event-desc">{{ event.description|slice(0, 100) }}...</p>

            <div class="event-meta">
                <div class="meta-item" title="Date">
                    📅 {{ event.dateDebut|date('M d, Y')|default('N/A') }}
                </div>
                <div class="meta-item" title="Location">
                    📍 {{ event.lieu }}
                </div>
                <div class="meta-item" title="Capacity">
                    👥 {{ event.capacite }} people
                </div>

                {% if event.sponsors|length > 0 %}
                <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed #eee; width: 100%;">
                    <div
                        style="font-size: 0.7rem; font-weight: 600; color: #888; margin-bottom: 4px; text-transform: uppercase;">
                        Sponsored By</div>
                    <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                        {% for sponsor in event.sponsors %}
                        <div title="{{ sponsor.nom }}"
                            style="width: 20px; height: 20px; border-radius: 50%; overflow: hidden; border: 1px solid #ddd; background: white; display: flex; align-items: center; justify-content: center;">
                            {% if sponsor.image %}
                            <img src="{{ sponsor.image }}" alt="{{ sponsor.nom }}"
                                style="width: 100%; height: 100%; object-fit: cover;">
                            {% else %}
                            <span style="font-size: 9px;">{{ sponsor.nom|slice(0, 1)|upper }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>

            <div class="event-actions">
                <a href="{{ path('admin_events_edit', {'id': event.id}) }}" class="admin-btn">Edit</a>
                <a href="{{ path('admin_events_delete', {'id': event.id}) }}" class="admin-btn admin-btn-danger"
                    onclick="return confirm('Are you sure you want to delete this event?');">Delete</a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="stat-card" style="text-align: center; grid-column: 1 / -1;">
    <div class="stat-card-icon">📭</div>
    <h3>No events found</h3>
    <p>Get started by creating your first event.</p>
    <a href="{{ path('admin_events_new') }}" class="admin-btn">Create First Event</a>
</div>
{% endif %}
{% endblock %}